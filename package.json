{
  "name": "antigravity-plugin-installer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Install and manage Antigravity plugins from GitHub repositories, npm packages, or local directories via an integrated MCP App UI.",
  "scripts": {
    "dev:ui": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "validate:plugin": "node scripts/validate-self.mjs",
    "install:local": "node scripts/install-local.mjs"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-singlefile": "^2.2.0"
  }
}
